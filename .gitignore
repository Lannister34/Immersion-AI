# Dependencies
node_modules/
.pnpm-store/

# Keep the lockfile versioned for deterministic installs and CI
!pnpm-lock.yaml

# Build output
apps/*/dist/
packages/*/dist/
apps/web/playwright-report/
apps/web/test-results/
*.tsbuildinfo
.turbo/

# User data (chats, characters, settings, etc.)
/data/

# Binary files
bin/
*.exe
models/
!apps/api/testdata/smoke-data/models/
!apps/api/testdata/smoke-data/models/**

# Environment & secrets
.env
secrets.json
config.yaml

# Editors & tools
.vscode/
.idea/
*.code-workspace
.DS_Store

# Internal docs and dev artifacts — not published
.claude/
.codex/
.aider*
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/ROADMAP.md
/docs/

# Logs
*.log
content.log
access.log

# OS
nul
Thumbs.db

# Design handoff bundles are internal working material
/design_handoff_*/

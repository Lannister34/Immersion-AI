{
  "extends": "../packages/tooling/tsconfig/base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../*.ts", "../*.cjs"]
}

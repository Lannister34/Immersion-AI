{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**",
      "packages/**/src/**",
      "packages/tooling/test/**",
      "apps/web/tests/**",
      "apps/web/dev-server/**",
      "apps/*/*.config.ts",
      "scripts/**",
      "*.cjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": false
      },
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useDefaultParameterLast": "off",
        "noNestedTernary": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "noInvalidUseBeforeDeclaration": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "packages/contracts/src/**/*.ts",
        "packages/domain/src/**/*.ts",
        "!apps/api/src/config/read-api-config.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/**/*.ts",
        "!apps/api/src/platform/outbound-http/**",
        "!apps/api/src/test-support/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Call outbound HTTP through the injected HttpFetch port (ADR-0004, decision 9).",
                  "globalThis": "Reach no global through globalThis: take the port the composition root injects (ADR-0004, decision 9).",
                  "global": "Reach no global through global: take the port the composition root injects (ADR-0004, decision 9)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/modules/**",
                      "**/shared/**",
                      "**/routes/**",
                      "**/test-support/**",
                      "**/composition/**",
                      "**/lifecycle/**",
                      "**/app.js",
                      "**/server.js",
                      "**/platform/**",
                      "!**/platform/net/loopback-address.js"
                    ],
                    "message": "config/ is the root of the API's import graph: it imports only other config/ files and the leaf platform/net/loopback-address.ts (ADR-0004, decision 7)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/modules/**",
                      "**/shared/**",
                      "**/routes/**",
                      "**/composition/**",
                      "**/lifecycle/**",
                      "**/app.js",
                      "**/server.js"
                    ],
                    "message": "A platform primitive knows no feature module: platform/ imports only config/, other platform/ files and test support (ADR-0004, decision 7)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/chats/**", "apps/api/src/modules/characters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/indexing/**", "**/indexing"],
                    "message": "chats and characters read the chat index through the ports they declare, which the composition root wires to the app's index, so neither imports indexing (ADR-0004, decision 9)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/platform/net/loopback-address.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!node:net"],
                    "message": "config/ imports the loopback predicate, so it stays a leaf: loopback-address.ts imports only node:net (ADR-0004, decision 7)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
